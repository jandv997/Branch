# Qorvex AI — copy to .env and .env.local
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME="Qorvex AI"

# PostgreSQL
DATABASE_URL=postgresql://qorvex:qorvex@localhost:5432/qorvex?schema=public

# Redis (sessions, 2FA challenges, locks, BullMQ)
REDIS_URL=redis://localhost:6379

# Auth
AUTH_SECRET=replace-with-64-char-random-string
SESSION_TTL_SECONDS=86400

# Seed accounts (dev only)
SEED_PASSWORD=Qorvex!demo2026

# Admin IP allowlist (comma-separated). Empty = allow all (dev).
ADMIN_IP_ALLOWLIST=

# KYC object storage (S3-compatible). Local disk used when unset.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
KYC_UPLOAD_DIR=./uploads/kyc

# Withdraw KYC threshold in USD cents
KYC_WITHDRAW_THRESHOLD_CENTS=100000

# Payment adapters: "dev" simulates instantly. "stripe" / "crypto" reserved.
PAYMENT_ADAPTER=dev
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Engine default daily rate in basis points (100 bps = 1.00%). Credits are min(engine, license cap).
ENGINE_DEFAULT_BPS=40

# Global halt flags (also editable in admin / CompConfig)
HALT_CREDITS=false
HALT_WITHDRAWS=false

# Worker
WORKER_CONCURRENCY=5
